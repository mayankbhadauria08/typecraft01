// Cloudflare Worker configuration for TypeCraft (see SETUP.md).
// index.html (the app) is only sent to signed-in browsers; everyone else gets
// login.html. /api/* runs the Worker code in src/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typecraft01",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // the API, and the pages that depend on whether you are signed in, go through the Worker
    "run_worker_first": ["/api/*", "/", "/index.html", "/login", "/login.html"],
    // files are served at their exact paths (the Worker asks for /index.html and /login.html)
    "html_handling": "none"
  },

  // ACCOUNTS DATABASE (SETUP.md, step 2): the D1 database "typecraft".
  // Its tables are created by migrations/0001_accounts.sql (SETUP.md, step 1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typecraft",
      "database_id": "9df6b720-1fbc-4022-b547-fdf86bd59a28",
      "migrations_dir": "migrations"
    }
  ],

  // Email settings (RESEND_API_KEY, EMAIL_FROM, optional APP_URL) are set as
  // secrets in the Cloudflare dashboard, never in this file. keep_vars stops a
  // deploy from removing anything set there.
  "keep_vars": true,

  // daily clean-up of expired sessions and links (02:47 India time)
  "triggers": { "crons": ["17 21 * * *"] },
  "observability": { "enabled": true }
}
